<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadContent</key>
			<dict>
				<key>com.paul-ej.brewmaster</key>
				<dict>
					<key>Forced</key>
					<array>
						<dict>
							<key>mcx_preference_settings</key>
							<dict>
								<key>AllowPackageInstallation</key>
								<true/>
								<key>AllowSelfUpdates</key>
								<true/>
								<key>AllowUnpinning</key>
								<true/>
								<key>AllowedPackages</key>
								<array/>
								<key>AllowedTaps</key>
								<array>
									<string>homebrew/core</string>
									<string>homebrew/cask</string>
								</array>
								<key>CriticalCVSSThreshold</key>
								<real>9</real>
								<key>CriticalUpdateDeadlineHours</key>
								<integer>24</integer>
								<key>CriticalUpdatesEnabled</key>
								<true/>
								<key>Enabled</key>
								<true/>
								<key>ExcludedPackages</key>
								<array/>
								<key>HighlightedPackages</key>
								<array/>
								<key>IncludeCasks</key>
								<true/>
								<key>IncludeFormulae</key>
								<true/>
								<key>MaintenanceWindowEnabled</key>
								<false/>
								<key>MaintenanceWindowEnd</key>
								<string>06:00</string>
								<key>MaintenanceWindowStart</key>
								<string>20:00</string>
								<key>MinimumSeverity</key>
								<string>high</string>
								<key>PackageAllowlistEnforced</key>
								<false/>
								<key>PartialFailureReporting</key>
								<true/>
								<key>RequireUpdateConfirmation</key>
								<false/>
								<key>UpdateCadenceDays</key>
								<integer>7</integer>
								<key>UpdatePolicy</key>
								<string>all</string>
								<key>VulnerabilityScanEnabled</key>
								<true/>
							</dict>
						</dict>
					</array>
				</dict>
			</dict>
			<key>PayloadDisplayName</key>
			<string>Brewmaster Managed Preferences</string>
			<key>PayloadIdentifier</key>
			<string>com.paul-ej.brewmaster.managed-preferences</string>
			<key>PayloadType</key>
