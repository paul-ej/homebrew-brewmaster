			<key>PayloadUUID</key>
			<string>09DC2943-B99D-424F-B6AE-7CD0EDE30B6B</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>PayloadDescription</key>
	<string>Policy template for Brewmaster 0.1.13. Review before deployment; customise identifiers and UUIDs for your organisation. Does not install Brewmaster or Homebrew.</string>
